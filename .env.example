# --- Auth ---------------------------------------------------------------
JWT_SECRET="change-me-to-a-long-random-string"
ADMIN_SECRET="change-me-optional-superadmin-bootstrap-secret"

# --- Bybit ----------------------------------------------------------------
# Only needed if/when authenticated Bybit endpoints are used. Public market
# data (tickers, klines) does not require these. Never expose in frontend.
BYBIT_API_KEY=""
BYBIT_API_SECRET=""

# --- Server -----------------------------------------------------------------
PORT=4000
NODE_ENV=development
MONITORING_INTERVAL_MS=15000
PERFORMANCE_INTERVAL_MS=300000
FRONTEND_ORIGIN="http://localhost:5173"

# --- Frontend (Vite exposes only NEXT_PUBLIC_*/VITE_* prefixed vars) --------
VITE_API_URL="http://localhost:4000"
NEXT_PUBLIC_API_URL="http://localhost:4000"

# --- WebSocket (reserved for market-data-v2, see market-data-service) ------
WEBSOCKET_URL="wss://stream.bybit.com/v5/public/linear"
